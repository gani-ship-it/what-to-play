# Application
APP_NAME="What-To-Play API"
APP_VERSION="0.1.0"
DEBUG=True
API_V1_STR="/api/v1"

# Database configuration
# For local dev without Docker, SQLite is active by default:
DATABASE_URL="sqlite+aiosqlite:///./wtp.db"
# For PostgreSQL (local or Supabase/Neon/Render):
# DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/wtp_db"

# External API Keys (Phase 2 - 4)
RAWG_API_KEY=""
CHEAPSHARK_BASE_URL="https://www.cheapshark.com/api/1.0"
STEAM_API_KEY=""
YOUTUBE_API_KEY=""

# Security
SECRET_KEY="insecure-dev-secret-key-change-in-production-wtp-2026"
ACCESS_TOKEN_EXPIRE_MINUTES=10080
